rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Komentar publik: siapa pun boleh baca & kirim, TAPI dengan batasan ketat
    // supaya database tidak disalahgunakan (spam/ukuran tak terbatas).
    match /komentar/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['nama', 'isi', 'createdAt'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 40
        && request.resource.data.isi is string
        && request.resource.data.isi.size() > 0
        && request.resource.data.isi.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false; // tidak ada yang boleh mengubah/menghapus via klien
    }
  }
}
